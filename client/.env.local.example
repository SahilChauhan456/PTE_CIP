# Base URL of the Express API.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Google OAuth 2.0 Web client ID (same value as the server's GOOGLE_CLIENT_ID).
# Exposed to the browser for Google Sign-In.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Canonical public origin of this deployment, no trailing slash. Feeds
# metadataBase, robots.txt and sitemap.xml. Defaults to https://pt-hub.in.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
